{
  "crons": [
    { "path": "/api/daily-case-check", "schedule": "0 12 * * *" }
  ],
  "headers": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page", "value": "jlc-report" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ]
}
